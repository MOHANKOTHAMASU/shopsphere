# =============================================================================
# ShopSphere E-Commerce - Environment Configuration
# =============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit production credentials or service role keys to git.

# -----------------------------------------------------------------------------
# 1. Supabase Backend & Database Configuration
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Service Role Key (Used ONLY in secure server actions/APIs, NEVER in client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase Storage Bucket Names
NEXT_PUBLIC_SUPABASE_PRODUCT_BUCKET=product-images
NEXT_PUBLIC_SUPABASE_AVATAR_BUCKET=avatars

# -----------------------------------------------------------------------------
# 2. Razorpay Payment Gateway (Test Mode)
# -----------------------------------------------------------------------------
# Found in: Razorpay Dashboard > Settings > API Keys (Generate Test Key)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# -----------------------------------------------------------------------------
# 3. Application Domain & URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# 4. Mobile SMS Gateway (Twilio REST API or Supabase Phone Auth)
# -----------------------------------------------------------------------------
# Required for real mobile SMS OTP delivery during customer login & phone verification.
# Obtain from Twilio Console (https://console.twilio.com/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
# Optional: Twilio Messaging Service SID (if configured in Twilio)
TWILIO_MESSAGING_SERVICE_SID=

# -----------------------------------------------------------------------------
# 5. Production Custom SMTP Email Provider (Optional / Recommended)
# -----------------------------------------------------------------------------
# Used to bypass Supabase free-tier 3-email/hr quota (e.g. Resend, SendGrid, AWS SES)
# Configure in Supabase Dashboard > Project Settings > Authentication > SMTP Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
